# Copy to .env.local and fill in. Never commit .env.local.

# Public address of the site (used for payment redirects and the sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mollie (https://www.mollie.com) — a test_ key is fine while building
MOLLIE_API_KEY=

# Shipping (in cents). Orders cannot be placed until the flat rate is set.
SHIPPING_FLAT_RATE_CENTS=
SHIPPING_FREE_FROM_CENTS=
DELIVERY_ESTIMATE=

# Other ways to pay (all optional). Offline orders are posted to ORDER_NOTIFY_WEBHOOK_URL
# (e.g. a Zapier/Make hook that e-mails you); without it these two options stay switched off.
ORDER_NOTIFY_WEBHOOK_URL=
# Direct bank transfer
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_BIC=
# Cash by post: the address to send it to (use \n for a new line)
CASH_ADDRESS=

# Customer accounts and order history.
# DATABASE_URL: connect Neon Postgres in the Vercel dashboard (Storage / Marketplace) and Vercel
# sets it for you. The tables are created automatically on first use.
DATABASE_URL=
# Emails (confirm address, forgot password, order confirmation) go through Resend (https://resend.com).
RESEND_API_KEY=
# The sender: an address on a domain you have verified in Resend, e.g. ALUWWAH <hello@yourdomain.com>
EMAIL_FROM=
